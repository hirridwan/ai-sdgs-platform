{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-sdgs-platform-workers",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-19",

  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },

  "placement": {
    "mode": "smart"
  },

  "secrets": {
    "required": ["GEMINI_API_KEY"]
  }
}
